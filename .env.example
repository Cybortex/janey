# Deployment and Environment Variables Guide

# Convex Backend
# Set this to your live Convex deployment URL (e.g. from `npx convex dev` or your Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud

# Site URL (for SEO, metadataBase, canonical links, and Paystack redirect callbacks)
NEXT_PUBLIC_SITE_URL=https://janeyradiance.com

# Paystack API Keys
# Secret key is strictly used on server-side routes (/api/paystack/initialize, /api/paystack/verify, and webhook signature verification)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Dashboard Protection
# Secret passphrase used to authenticate the salon owner at /admin
ADMIN_SECRET=janeyadmin2026
